NODE_ENV=development
PORT=4000

# Provider API keys (set at least one)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=
OPENROUTER_API_KEY=
HF_API_KEY=
DEEPSEEK_API_KEY=
KIMI_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=

# --- Newly added free / free-tier providers ---
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
FIREWORKS_API_KEY=
INFERENCE_API_KEY=
NEBIUS_API_KEY=
SAMBANOVA_API_KEY=
NVIDIA_API_KEY=
NOVITA_API_KEY=
BASETEN_API_KEY=
MODELSCOPE_API_KEY=
AIMLAPI_API_KEY=
# CLOUDFLARE_API_KEY / CLOUDFLARE_ACCOUNT_ID: Workers AI, free daily neuron
#   allocation, no card required. Both values are required together — the
#   adapter reports itself unconfigured if either is missing.
# FIREWORKS_API_KEY: free trial credits on signup at fireworks.ai.
# INFERENCE_API_KEY: free tier at inference.net, no card required.
# NEBIUS_API_KEY: free trial credits at studio.nebius.com.
# SAMBANOVA_API_KEY: free tier at cloud.sambanova.ai, RDU-accelerated
#   inference, up to 256K context on some models.
# NVIDIA_API_KEY: free NVIDIA developer tier at build.nvidia.com (NIM).
# NOVITA_API_KEY: free starter credits at novita.ai.
# BASETEN_API_KEY: free trial credits at baseten.co (Model APIs).
# MODELSCOPE_API_KEY: free tier at modelscope.cn (Alibaba).
# AIMLAPI_API_KEY: free credits at aimlapi.com, aggregates many open models.

# DEEPSEEK_API_KEY: 5M free tokens on signup (no card), then ~$0.14/1M tokens.
# KIMI_API_KEY: requires a minimum $1 recharge to activate, then cheap after.
# CEREBRAS_API_KEY: genuinely free, no card, 1M tokens/day (resets daily),
#   extremely fast wafer-scale inference. Sign up at cloud.cerebras.ai.
# MISTRAL_API_KEY: free "Experiment" tier, no card, ~1B tokens/month,
#   includes Codestral for coding. Sign up at console.mistral.ai.
# For a genuinely $0 alternative to DeepSeek/Kimi specifically, use
# OPENROUTER_API_KEY (free to create) and set model to a ":free"-suffixed
# variant, e.g. "deepseek/deepseek-chat-v3.1:free" or "moonshotai/kimi-k2:free"
# — pass it as the `model` field on a request with forceProvider=openrouter.

# Cache (optional)
REDIS_URL=
CACHE_ENABLED=false
CACHE_TTL_SECONDS=300

# Database
DATABASE_URL=./data/gateway.db

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# Request handling
MAX_PROMPT_LENGTH=3500000
REQUEST_TIMEOUT_MS=30000
MAX_RETRIES=2
# Global wall-clock budget shared by the entire provider failover chain.
# This is separate from individual provider/request timeouts.
GATEWAY_REQUEST_BUDGET_MS=60000

# CORS
CORS_ORIGIN=*

LOG_LEVEL=info
