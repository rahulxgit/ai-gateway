NODE_ENV=development
PORT=4000

# Provider API credentials
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=
OPENROUTER_API_KEY=
HF_TOKEN=
HF_API_KEY=
DEEPSEEK_API_KEY=
KIMI_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
CLOUDFLARE_AUTH_TOKEN=
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
FIREWORKS_API_KEY=
INFERENCE_API_KEY=
NEBIUS_API_KEY=
SAMBANOVA_API_KEY=
NVIDIA_API_KEY=
NOVITA_API_KEY=
BASETEN_API_KEY=
MODELSCOPE_SDK_TOKEN=
MODELSCOPE_ACCESS_TOKEN=
MODELSCOPE_API_KEY=
AIMLAPI_API_KEY=

# Automatic routing is intentionally FREE-TIER ONLY.
# Paid/trial providers remain available when explicitly selected with
# forceProvider, but they are not selected automatically and are not
# inference-probed for health (to avoid unexpected charges).

# Current free-oriented defaults:
# Gemini: gemini-2.5-flash-lite
# Groq: openai/gpt-oss-20b
# OpenRouter: openrouter/free
# Cloudflare Workers AI: @cf/zai-org/glm-4.7-flash
# NVIDIA API: openai/gpt-oss-20b
# ModelScope: Qwen/Qwen3-32B
# SambaNova: DeepSeek-V3.2

REDIS_URL=
CACHE_ENABLED=false
CACHE_TTL_SECONDS=300
DATABASE_URL=./data/gateway.db
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
MAX_PROMPT_LENGTH=3500000
REQUEST_TIMEOUT_MS=30000
MAX_RETRIES=2
GATEWAY_REQUEST_BUDGET_MS=60000
DAILY_COST_BUDGET_USD=0
CORS_ORIGIN=*
LOG_LEVEL=info
