NODE_ENV=development
PORT=4000

# Provider API keys (set at least one)
# Google AI Studio / Gemini Developer API. The gateway uses Google's
# OpenAI-compatible Chat Completions endpoint for the common chat path.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
HF_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=

# --- Newly added free / free-tier providers ---
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
FIREWORKS_API_KEY=
NVIDIA_API_KEY=
NOVITA_API_KEY=
BASETEN_API_KEY=
COHERE_API_KEY=
# CLOUDFLARE_API_KEY / CLOUDFLARE_ACCOUNT_ID: Workers AI, free daily neuron
#   allocation, no card required. Both values are required together — the
#   adapter reports itself unconfigured if either is missing.
# FIREWORKS_API_KEY: free trial credits on signup at fireworks.ai.
# NVIDIA_API_KEY: free NVIDIA developer tier at build.nvidia.com (NIM).
# NOVITA_API_KEY: free starter credits at novita.ai.
# BASETEN_API_KEY: free trial credits at baseten.co (Model APIs).
# COHERE_API_KEY: genuinely free, no card, RECURRING quota (not a one-time
#   trial) — a Cohere "Trial" key from dashboard.cohere.com, 1,000 calls/
#   month, 20 req/min on Chat. Included in automatic free-routing, ordered
#   last since its monthly quota is the lowest of the free-auto pool —
#   reached as a last-resort fallback rather than on every request.

# CEREBRAS_API_KEY: genuinely free, no card, 1M tokens/day (resets daily),
#   extremely fast wafer-scale inference. Sign up at cloud.cerebras.ai.
# MISTRAL_API_KEY: free "Experiment" tier, no card, ~1B tokens/month,
#   includes Codestral for coding. Sign up at console.mistral.ai.
# For a genuinely $0 alternative to paid coding-model providers, use
# OPENROUTER_API_KEY (free to create) and set model to a ":free"-suffixed
# variant, e.g. "deepseek/deepseek-chat-v3.1:free" or "moonshotai/kimi-k2:free"
# — pass it as the `model` field on a request with forceProvider=openrouter.

# Cache (optional)
# Set CACHE_ENABLED=true together with REDIS_URL to enable the shared Redis
# L2 cache. The existing in-process cache remains L1 and is always used first.
REDIS_URL=
CACHE_ENABLED=false
CACHE_TTL_SECONDS=300

# Database
DATABASE_URL=./data/gateway.db

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# Request handling
MAX_PROMPT_LENGTH=3500000
REQUEST_TIMEOUT_MS=30000
MAX_RETRIES=2
# Global wall-clock budget shared by the entire provider failover chain.
# This is separate from individual provider/request timeouts.
GATEWAY_REQUEST_BUDGET_MS=60000
# Optional rolling 24-hour estimated spend guard. 0 disables the guard.
DAILY_COST_BUDGET_USD=0

# CORS
CORS_ORIGIN=*

LOG_LEVEL=info
